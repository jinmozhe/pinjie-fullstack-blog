# =============================================
# Admin 前端环境变量（Umi Max）
# 复制为 .env.local 并填入真实值
# VITE_ 前缀的变量会暴露给浏览器端
# =============================================

# 默认留空，浏览器只访问同域 /api/v1，由 Umi 开发代理或生产 Nginx 转发。
# 该值会在构建时公开到浏览器；只有部署方明确承担跨域 Cookie 与 CORS 契约时才设置完整公开地址。
VITE_API_URL=

# 本机开发代理目标，生产由 Nginx 使用容器地址。
BACKEND_INTERNAL_URL=http://localhost:8000
