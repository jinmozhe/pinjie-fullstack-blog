{
  "name": "@pinjie/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "根据 OpenAPI 规范自动生成的 TypeScript 请求 SDK",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts",
    "./client.gen": "./src/client.gen.ts"
  },
  "scripts": {
    "generate": "openapi-ts --input ../../openapi.json --output ./src --client @hey-api/client-axios"
  },
  "dependencies": {
    "axios": "^1.7.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "typescript": "5.9.3"
  }
}
